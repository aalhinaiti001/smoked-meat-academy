---
import type { Question } from '../data/faq';
interface Props { items: readonly Question[] }
const { items } = Astro.props;
---
<div class="acc reveal" style="margin-top:2rem">
  {items.map((item) => (
    <div class="acc__item">
      <button class="acc__btn" type="button" aria-expanded="false">
        {item.q}<span>+</span>
      </button>
      <div class="acc__panel"><p>{item.a}</p></div>
    </div>
  ))}
</div>

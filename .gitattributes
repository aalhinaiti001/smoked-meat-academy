# The page generators are run by bash; a CRLF line ending makes it read the
# carriage return as part of each command and the build stops working. Keep
# these files LF in the repository and in every checkout, whatever the editor
# or the GitHub web UI would otherwise write.
*.sh text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.xml text eol=lf
robots.txt text eol=lf
CNAME text eol=lf

*.png binary
*.svg text eol=lf
